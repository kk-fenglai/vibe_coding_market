// ════════════════════════════════════════════════════════════════════════════
// 托管支付层 —— 托管单 / 纠纷 / 钱包流水（PRD 6.6、5.1、5.3）
// 资金流：客户付款 → HELD(平台托管) → 交付确认(或超时自动确认) → RELEASED(打款+抽佣)
// V1 provider = MOCK：钱包流水模拟，不动真钱；接 Stripe Connect 时只换 provider 实现。
// 里程碑分段托管是 V1.5，本层暂不建模。
// ════════════════════════════════════════════════════════════════════════════

model EscrowTransaction {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId  String
  client    User    @relation("EscrowClient", fields: [clientId], references: [id], onDelete: Cascade)
  builderId String
  builder   User    @relation("EscrowBuilder", fields: [builderId], references: [id], onDelete: Cascade)

  amount   Decimal @db.Decimal(12, 2)   // 成交金额（= 被接受申请的报价）
  currency String  @default("CNY")

  // 抽佣：默认 10%，同一客户-Builder 复购降至 5%（PRD 5.3），下单时快照到本行
  feeRate       Decimal @db.Decimal(5, 4) @default(0.1000)
  platformFee   Decimal @db.Decimal(12, 2)
  builderPayout Decimal @db.Decimal(12, 2)

  status String @default("PENDING")     // PENDING | HELD | DISPUTED | RELEASED | REFUNDED | CANCELLED

  provider    String  @default("MOCK")  // MOCK | STRIPE_CONNECT
  providerRef String?                    // PaymentIntent / Transfer id

  fundedAt      DateTime?               // 客户付款成功 → HELD
  autoConfirmAt DateTime?               // 交付后 +7 天自动确认（后台 worker 扫描此字段）
  releasedAt    DateTime?
  refundedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dispute Dispute?
  ledger  WalletLedger[]

  @@index([status, autoConfirmAt])
  @@index([clientId, status])
  @@index([builderId, status])
}

// ---------------- 纠纷仲裁（PRD 6.6，V1 运营人工裁定）----------------
model Dispute {
  id       String            @id @default(cuid())
  escrowId String            @unique
  escrow   EscrowTransaction @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  raisedById String
  raisedBy   User   @relation("DisputeRaiser", fields: [raisedById], references: [id], onDelete: Cascade)
  reason     String @db.Text
  evidence   Json?                       // [{name,url,type}]

  status     String    @default("OPEN")  // OPEN | RESOLVED_RELEASE | RESOLVED_REFUND | RESOLVED_SPLIT | WITHDRAWN
  resolution String?   @db.Text          // 裁定说明（对双方可见）
  refundAmount Decimal? @db.Decimal(12, 2) // RESOLVED_SPLIT 时退给客户的金额
  resolvedById String?                    // 处理管理员 User.id
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ---------------- 钱包 + 流水（MOCK 托管的账本）----------------
model Wallet {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency String  @default("CNY")
  balance  Decimal @db.Decimal(12, 2) @default(0)  // 可提现余额
  held     Decimal @db.Decimal(12, 2) @default(0)  // 托管中（客户已付、未释放）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 只追加，不修改：任何余额变动都写一行，balanceAfter 便于对账。
model WalletLedger {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   String  // DEPOSIT | ESCROW_HOLD | ESCROW_RELEASE | PLATFORM_FEE | REFUND | WITHDRAWAL
  amount Decimal @db.Decimal(12, 2)    // 有符号：入账为正，出账为负
  balanceAfter Decimal @db.Decimal(12, 2)
  currency     String  @default("CNY")

  escrowId String?
  escrow   EscrowTransaction? @relation(fields: [escrowId], references: [id], onDelete: SetNull)
  note     String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([escrowId])
}
